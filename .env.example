# 配置文件（复制本文件为 .env 后填写）
# 在软件界面点「打开 .env」即可编辑本文件（不存在时会自动从模板复制）。

# 你的 API Key（必填，替换成你自己的，如 sk-1a2b3c…）
API_KEY=sk-your-key-here

# OpenAI 兼容接口地址（默认 DeepSeek，一般无需修改）
BASE_URL=https://api.deepseek.com

# 模型名
MODEL=deepseek-chat

# 提交信息语言：auto / zh / en
COMMIT_LANGUAGE=zh

# 提交信息风格：conventional（Conventional Commits）/ simple
COMMIT_STYLE=conventional

# 发给模型的 diff 行数上限，超出会被截断
MAX_DIFF_LINES=600

# 作为风格参考的近期提交数量
RECENT_COMMITS=5